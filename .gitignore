# Root-level ignores for the EJ replication repository.
# Fortran-specific ignores live in fortran_code/.gitignore.

# IDE / editor clutter
.vs/
.claude/

# Scratch working dir (sandbox session artefacts, not part of repo)
tmp/

*.suo
*.user
.DS_Store
Thumbs.db
desktop.ini

# Stata temp / log output
*.log
*.bak
*.smcl

# Pipeline intermediates regenerated by
# inputs_stata_code/income_process/run_estimation.bat
# (_data_omega_*.txt and _data_sigma2eps_*.txt outputs stay tracked.
#  H.mat/L.mat themselves are NOT tracked — they are overwritten by every
#  run, incl. default N_REPS=0. Instead, H_archive.mat/L_archive.mat hold
#  the authors' 1000-rep bootstrap; plot_estimates.m prefers them for
#  confidence bands so a default point-estimate rerun cannot clobber the
#  paper baseline.)
inputs_stata_code/income_process/output/**/*.dta
inputs_stata_code/income_process/output/**/*.mat
!inputs_stata_code/income_process/output/**/H_archive.mat
!inputs_stata_code/income_process/output/**/L_archive.mat
inputs_stata_code/income_process/output/**/cov_binned/

# ---------------------------------------------------------------------------
# Large raw data — kept on disk, not in git.
# Pull these from the original sources (see input-data-file-provenance.md).
# ---------------------------------------------------------------------------

# Raw PSID and SCF extracts
data/PSID/
data/SCF/

# Root-level PSID extract (psid.dta, ~98 MB) consumed by
# inputs_stata_code/income_process/estimate_income_process.do
psid/

# Baseline model-ready panel (200 MB)
data/model_psid_all_govt__.dta

# ACS college-share extract (2 GB)
inputs_stata_code/skill_premium/ACS_college/ACS_college.dta

# UN World Population Prospects mortality table (180 MB)
inputs_stata_code/demography/mortality/WPP2022_MORT_F07_1_ABRIDGED_LIFE_TABLE_BOTH_SEXES.xlsx

# Transient Stata scratch files — auto-created by _prog_coding.do
# (outputs side) and _prepare_programs.do (inputs side), erased at end of run
**/bone.dta
**/bone1y.dta

# Root-level ignores for the EJ replication repository.
# Fortran-specific ignores live in fortran_code/.gitignore.

# IDE / editor clutter
.vs/
.claude/

*.suo
*.user
.DS_Store
Thumbs.db
desktop.ini

# Stata temp / log output
*.log
*.bak
*.smcl

# Pipeline intermediates regenerated by
# inputs_stata_code/income_process/run_estimation.bat
# (_data_omega_*.txt and _data_sigma2eps_*.txt outputs stay tracked)
inputs_stata_code/income_process/output/**/*.dta
inputs_stata_code/income_process/output/**/*.mat
inputs_stata_code/income_process/output/**/cov_binned/

